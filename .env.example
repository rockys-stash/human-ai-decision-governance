# Copy to .env and edit. `make serve` exports these; nothing reads .env automatically otherwise.
# Never commit .env.

# Bind address and port for `governance serve`.
GOVERNANCE_HOST=127.0.0.1
GOVERNANCE_PORT=8000

# SQLite file for the live review queue and audit log (created and seeded on first start).
GOVERNANCE_DB=var/governance.db
# Cases seeded per domain into an empty database. 0 seeds nothing.
GOVERNANCE_SEED_CASES=200

# Optional bearer token for every /api read except /api/health, for headless API use.
# The console does not send it, so leave it empty when serving the console (see docs/REVIEW.md S3).
GOVERNANCE_API_TOKEN=
# Reviewer identities as name:token pairs, comma-separated. Tokens must be at least 16 characters.
# With no reviewers configured, decisions are disabled (HTTP 403) and the console is read-only.
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(24))"
GOVERNANCE_REVIEWER_TOKENS=

# Read requests per second per client (writes are fixed at 1/s, burst 20).
GOVERNANCE_RATE_PER_SEC=50
